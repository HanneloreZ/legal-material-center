    {
      "document_id": "documents-c759c906e15e5c579606",
      "revision": 1,
      "title": "阶段性法律研究备忘录",
      "engine": "documents",
      "formats": [
        "docx",
        "pdf"
      ],
      "pdf_mode": "searchable",
      "payload": {
        "document": {
          "schema_version": "legal-document/1",
          "id": "example-legal-research-memo",
          "template_id": "legal-research-memo",
          "title": "阶段性法律研究备忘录",
          "fields": {
            "number": "{{备忘录编号}}",
            "recipient": "项目法务组（合成）",
            "author": "内部法务研究组（合成）",
            "date": "{{备忘录日期}}",
            "jurisdiction": "待确认的适用法域",
            "question": "拟议业务安排涉及的准入与持续合规事项",
            "factCutoff": "{{事实资料截止日}}",
            "researchCutoff": "{{法律研究截止日}}",
            "version": "v0.1 初步研究稿",
            "reviewStatus": "尚待负责人复核；未作为最终法律意见提交",
            "useScope": "供项目内部研究和讨论，后续随事实补充与复核意见更新"
          },
          "sections": [
            {
              "heading": "研究事项与初步摘要",
              "body": "项目组拟就一项业务安排开展法律研究。本稿记录目前识别的问题与初步分析；尚未就最终方案形成审定结论。"
            },
            {
              "heading": "已知事实与分析假设",
              "body": "事实资料截止日为{{事实资料截止日}}。现有资料仅包括业务方的简要说明。交易主体、业务模式、金额、实施地点及相关文件版本仍待进一步确认；初步分析所依赖的假设应在此逐项说明。"
            },
            {
              "heading": "研究范围与材料来源",
              "body": "法律研究截止日为{{法律研究截止日}}，本备忘录形成日期为{{备忘录日期}}。本轮拟核对适用法律、监管口径与有关先例。资料名称、版本、出处、取得日期和实际核验范围分别记载；尚未取得或未核验的材料保持待核状态。"
            },
            {
              "heading": "初步法律分析",
              "body": "按研究问题分别列明规则、适用条件、事实对应关系与初步判断。法律意见和建议可作为本类文书的正文，但应保留其形成时间、事实假设及尚待复核的范围。"
            },
            {
              "heading": "风险 相反观点与分析限制",
              "body": "就尚有争议或资料不足的事项，分别记录可能的不同解释、支持材料与其适用前提。当前未核实的监管实践、许可状态及后果，不因被写入本稿而视为已经核实。"
            },
            {
              "heading": "待核事项与后续工作",
              "body": "下一步由项目组补充事实材料，研究组核对关键法律来源，并由负责人提出复核意见。负责人、完成时间和反馈情况按实际进展填写。"
            },
            {
              "heading": "版本与复核记录",
              "body": "v0.1：初步研究稿，待内部复核。后续修改分别记录版本、日期、修改事项与复核人；未收到反馈时不记载已经批准或定稿。"
            }
          ]
        }
      }
